@set G_YuinaIndex?=0

@showPrinter YuinaPrinter
@printer YuinaPrinter default! !hideOther
@resetText YuinaPrinter

@goto #Talk00 if:G_YuinaIndex==0
@goto #Talk01 if:G_YuinaIndex==1
@goto #Talk02 if:G_YuinaIndex==2
@goto #Talk03 if:G_YuinaIndex==3
@goto #Talk04 if:G_YuinaIndex==4
@goto #Talk05 if:G_YuinaIndex==5
@goto #Talk06 if:G_YuinaIndex==6
@goto #Talk07 if:G_YuinaIndex==7
@goto #Talk08 if:G_YuinaIndex==8
@goto #Talk09


# Talk00
@char Yuina.Happy pos:23,0 scale:0.5 wait:false
@print "There you are, {PlayerName}. Ready to move the train a little farther?" printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=1
@stop


# Talk01
@char Yuina.Serious pos:23,0 scale:0.5 wait:false
@print "Don't wait for the perfect immersion session. Ten honest minutes with Japanese are worth more than an hour you keep postponing." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=2
@stop


# Talk02
@char Yuina.Happy pos:23,0 scale:0.5 wait:false
@print "You don't need to understand everything. Noticing one expression you missed yesterday is already evidence that something is changing." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=3
@stop


# Talk03
@char Yuina.Decided pos:23,0 scale:0.5 wait:false
@print "Reading helps you notice structure and vocabulary. Listening teaches your brain to recognise them before you have time to translate. We need both." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=4
@stop


# Talk04
@char Yuina.Hehe pos:23,0 scale:0.5 wait:false
@print "Anime, novels, videos, podcasts... the train isn't picky. Just make sure you're actually spending time with Japanese and not decorating a study plan." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=5
@stop


# Talk05
@char Yuina.Worry pos:23,0 scale:0.5 wait:false
@print "A quiet week doesn't erase what you've acquired. Come back gently instead of trying to punish yourself with a six-hour marathon." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=6
@stop


# Talk06
@char Yuina.Announce pos:23,0 scale:0.5 wait:false
@print "Repeated encounters are doing more work than you realise. Every time a word returns, your brain gets another chance to make it familiar." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=7
@stop


# Talk07
@char Yuina.Angry pos:23,0 scale:0.5 wait:false
@print "And don't turn one bad day into a bad month. Missing a session is normal. Abandoning the journey because of it would be rather silly." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=8
@stop


# Talk08
@char Yuina.Happy pos:23,0 scale:0.5 wait:false
@print "Wakkanai is still far away, but that's the point. You aren't supposed to finish a language quickly. You're supposed to grow into it." printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=9
@stop


# Talk09
@char Yuina.Hehe pos:23,0 scale:0.5 wait:false
@print "You provide the hours, and I'll keep the train on schedule. A rather fair arrangement, don't you think?" printer:YuinaPrinter author:Yuina !waitInput
@set G_YuinaIndex=0
@stop